# Server Configuration
PORT=5000
NODE_ENV=development

BASE_URL=http://localhost:5000
CORS_ORIGIN=*
RATE_LIMIT_MAX=300
SESSION_SECRET=your_session_secret_key_here

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/doctalker

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE_TIME=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/user/auth/google/callback

# AWS S3 Storage
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_BUCKET_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AI Providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

HUGGING_FACE_KEY=your_huggingface_api_key
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Stripe Payment
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Service (Hotmail or standard SMTP)
HOTMAIL_EMAIL=your_email@outlook.com
HOTMAIL_PASSWORD=your_email_password


# Optional SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_SECURE=false
